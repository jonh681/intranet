# Seguridad básica del sistema de tickets (Apache 2.4 / LiteSpeed).
Options -Indexes

# En el servidor, todo por HTTPS (la información y las contraseñas viajan cifradas). No aplica en localhost.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Bloquea archivos ocultos (.env, .git, .htaccess) y archivos que no deben descargarse.
<FilesMatch "(^\.|\.(env|example|sql|md|bat|exe|log|zip|bak|old)$)">
    Require all denied
</FilesMatch>
