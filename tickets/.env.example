# Plantilla de la configuración privada de TODA la intranet (tickets, asistencia e incidencias).
#   - Local:    tickets/.env
#   - Servidor: /home/USUARIO/intranet.env  (fuera de public_html; con la intranet en public_html/intranet)
# Nunca subas el archivo real a git ni dentro del zip de despliegue.

# Base de datos MySQL/MariaDB (la base unida "intranet")
TICKETS_DB_HOST=localhost
TICKETS_DB_PORT=3306
TICKETS_DB_NAME=intranet
TICKETS_DB_USER=root
TICKETS_DB_PASSWORD=

# Contraseña de la cuenta no-responder@fedele.com.mx (envío de todos los correos, comun/correo.php)
SMTP_PASS=

# Si tiene un correo, todos los avisos se envían solo a esa dirección (pruebas). Vacío = destinatarios reales.
# Los códigos de acceso y los enlaces de contraseña siempre van a su dueño.
TICKETS_MODO_PRUEBA=

# Dirección pública de la intranet (enlaces de los correos), p. ej. https://dominio.com/intranet
INTRANET_URL=

# Llave de cifrado de evidencias de tickets (32 bytes en base64). Genérala con:
#   php -r "echo base64_encode(random_bytes(32));"
# No la pierdas ni la cambies: sin ella las evidencias cifradas no se pueden abrir.
TICKETS_APP_KEY=

# Código de acceso por correo para soporte, supervisión y superusuario (1 = activo, 0 = desactivado solo en emergencias).
TICKETS_CODIGO_ACCESO=1

# 0 = no se envía ningún correo (se guardan en correos/). Ojo: sin correos nadie recibe su código de acceso.
TICKETS_CORREO_ACTIVO=1

# Servidor de correo (opcional; por omisión mail.fedele.com.mx).
TICKETS_SMTP_HOST=

# Solo local: entrar eligiendo el tipo de usuario, sin contraseña (dev.php). NUNCA en el servidor.
# INTRANET_DEV=1
